formulas:
  days_left: if(note.date, ((number(date(note.date)) - number(today())) / 86400000).round(), "")
properties:
  note.title:
    displayName: Title
  note.minutes:
    displayName: Minutes
  formula.days_left:
    displayName: Days left
views:
  - type: table
    name: To read
    filters:
      and:
        - file.inFolder("courses")
        - file.path.contains("/lessons/")
        - verified == true
        - done != true
    groupBy:
      property: course
      direction: ASC
    order:
      - file.name
      - title
      - goals
      - minutes
      - done
    sort:
      - property: file.name
        direction: ASC
    summaries:
      minutes: Sum
  - type: table
    name: All lessons
    filters:
      and:
        - file.inFolder("courses")
        - file.path.contains("/lessons/")
    groupBy:
      property: course
      direction: ASC
    order:
      - file.name
      - title
      - goals
      - minutes
      - verified
      - done
    sort:
      - property: file.name
        direction: ASC
    summaries:
      minutes: Sum
  - type: table
    name: Needs checking
    filters:
      and:
        - file.inFolder("courses")
        - file.path.contains("/lessons/")
        - verified != true
    order:
      - file.name
      - title
      - course
      - goals
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Goals
    filters:
      and:
        - file.inFolder("goals")
    order:
      - file.name
      - title
      - date
      - formula.days_left
      - status
      - cram
    sort:
      - property: date
        direction: ASC
  - type: table
    name: This goal
    filters:
      and:
        - file.inFolder("courses")
        - file.path.contains("/lessons/")
        - course == this.course
        - goals.contains(this.id)
    order:
      - file.name
      - title
      - minutes
      - verified
      - done
    sort:
      - property: file.name
        direction: ASC
    summaries:
      minutes: Sum
