formulas:
  days_left: if(note.date, ((number(date(note.date)) - number(today())) / 86400000).round(), "")
properties:
  note.title:
    displayName: Title
  note.minutes:
    displayName: Minutes
  formula.days_left:
    displayName: Days left
  note.goal_note:
    displayName: Goal
  note.cram:
    displayName: Cram
  note.lessons_left:
    displayName: Lessons left
  note.minutes_left:
    displayName: Minutes left
  note.new_cards_per_day:
    displayName: New cards/day
views:
  - type: table
    name: Goals
    filters:
      and:
        - file.inFolder("timetable")
    order:
      - goal_note
      - date
      - formula.days_left
      - cram
      - lessons_left
      - minutes_left
      - new_cards_per_day
    sort:
      - property: date
        direction: ASC
    columnSize:
      note.goal_note: 220
      note.date: 130
      formula.days_left: 85
      note.cram: 65
      note.lessons_left: 105
      note.minutes_left: 110
      note.new_cards_per_day: 125
  - type: table
    name: To read
    filters:
      and:
        - file.inFolder("courses")
        - file.path.contains("/lessons/")
        - verified == true
        - done != true
    groupBy:
      property: course
      direction: ASC
    order:
      - file.name
      - title
      - goals
      - minutes
      - done
    sort:
      - property: file.name
        direction: ASC
    summaries:
      minutes: Sum
    columnSize:
      file.name: 220
      note.title: 260
      note.goals: 120
      note.minutes: 90
      note.done: 65
  - type: table
    name: All lessons
    filters:
      and:
        - file.inFolder("courses")
        - file.path.contains("/lessons/")
    groupBy:
      property: course
      direction: ASC
    order:
      - file.name
      - title
      - goals
      - minutes
      - verified
      - done
    sort:
      - property: file.name
        direction: ASC
    summaries:
      minutes: Sum
    columnSize:
      file.name: 220
      note.title: 260
      note.goals: 120
      note.minutes: 90
      note.verified: 80
      note.done: 65
  - type: table
    name: Needs checking
    filters:
      and:
        - file.inFolder("courses")
        - file.path.contains("/lessons/")
        - verified != true
    order:
      - file.name
      - title
      - course
      - goals
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 220
      note.title: 260
      note.course: 100
      note.goals: 120
